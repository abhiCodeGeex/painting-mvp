APP_NAME="Paint MVP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker service names (see compose.yaml). From the Windows host use 127.0.0.1:25432.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=paint_mvp
DB_USERNAME=paint
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=paint_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches all mail in dev: http://localhost:18026
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="quotes@paint-mvp.test"
MAIL_FROM_NAME="${APP_NAME}"

# PDF rendering (spatie/laravel-pdf + Gotenberg)
LARAVEL_PDF_DRIVER=gotenberg
GOTENBERG_URL=http://gotenberg:3000

# First Super Admin created by the seeder (change after first login)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@paint-mvp.test
ADMIN_PASSWORD=password

# Business defaults
APP_CURRENCY=INR

VITE_APP_NAME="${APP_NAME}"
